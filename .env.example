# Environment Configuration
# Copy this file to .env and update values for production

# JWT Secret Key - CHANGE THIS IN PRODUCTION!
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-in-production

# Allowed frontend origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database URL (SQLite for development, PostgreSQL for production)
# SQLite: sqlite:///./seekai.db
# PostgreSQL: postgresql://user:password@localhost:5432/seekai
DATABASE_URL=sqlite:///./seekai.db

# OAuth2 Providers (optional)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# OAuth2 Callback URLs (defaults)
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/oauth/google/callback
# GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/oauth/github/callback